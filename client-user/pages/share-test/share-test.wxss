/* pages/share-test/share-test.wxss */
.container {
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
}

.input-section {
  margin-bottom: 32rpx;
}

.input {
  border: 1rpx solid #ddd;
  padding: 20rpx;
  border-radius: 8rpx;
}

.result-section {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.result-text {
  font-size: 24rpx;
  word-break: break-all;
}

.qrcode-section {
  margin-top: 32rpx;
  text-align: center;
}

.qrcode-image {
  width: 400rpx;
  height: 400rpx;
  margin: 24rpx 0;
}
